# ==================== 数据库配置 ====================
DB_URL=postgresql://postgres:XXX@localhost:5432/xxxx

# ==================== LLM 供应商配置 ====================
# 供应商类型: openai | azure_openai | deepseek | zhipu | ollama | vllm | anthropic | dashscope
LLM_PROVIDER=openai

# 模型名称（各供应商的模型 ID）
MODEL_NAME=gpt-4o

# API Key（通用字段，优先级高于下方旧字段）
LLM_API_KEY=XXX

# API 基础地址（通用字段，优先级高于下方旧字段）
LLM_BASE_URL=https://api.openai.com/v1

# 温度参数（默认 0.0）
LLM_TEMPERATURE=0.0

# ---- 以下为旧字段，仍被兼容读取（LLM_API_KEY / LLM_BASE_URL 未设置时回退） ----
OPENAI_API_KEY=XXX
OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== 各供应商示例 ====================
# --- DeepSeek ---
# LLM_PROVIDER=deepseek
# MODEL_NAME=deepseek-chat
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1

# --- Ollama（本地推理，无需 API Key） ---
# LLM_PROVIDER=ollama
# MODEL_NAME=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434

# --- vLLM（本地推理，兼容 OpenAI 协议） ---
# LLM_PROVIDER=vllm
# MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# LLM_BASE_URL=http://localhost:8000/v1

# --- 智谱 AI ---
# LLM_PROVIDER=zhipu
# MODEL_NAME=glm-4
# LLM_API_KEY=xxx.xxx

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-4-20250514
# LLM_API_KEY=sk-ant-xxx

# --- Azure OpenAI ---
# LLM_PROVIDER=azure_openai
# MODEL_NAME=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_NAME=my-deployment
# AZURE_OPENAI_API_VERSION=2024-06-01
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://xxx.openai.azure.com/

# --- 阿里云百炼 / 通义千问 ---
# LLM_PROVIDER=dashscope
# MODEL_NAME=qwen-plus
# LLM_API_KEY=sk-xxx

# ==================== Embedding 配置 ====================
MBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=d:/work/text2sql2/models/bge-m3

# ==================== HuggingFace 镜像 ====================
HF_ENDPOINT=https://hf-mirror.com
