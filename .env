# ==================== 数据库配置 ====================
DB_URL=postgresql://postgres:postgres123@localhost:5432/city_planning

# ==================== API Key & 中转站配置 ====================
# 如果使用中转站（如 OpenAI 中转、DeepSeek、硅基流动、OneAPI 等），请按下面格式填写
# OPENAI_API_KEY=sk-F2U2zWgFuzxM56e11OoWY7u8yByHy8NaYzZPuteWUg7ESCwW
# OPENAI_BASE_URL=https://api.csun.site/v1          # ← 这里改成你的中转站地址

# MODEL_NAME=gpt-4o

# 供应商类型: openai | azure_openai | deepseek | zhipu | ollama | vllm | anthropic | dashscope
LLM_PROVIDER=ollama

# 模型名称（各供应商的模型 ID）
MODEL_NAME=qwen3:30b-a3b-q4_K_M

# # API Key（通用字段，优先级高于下方旧字段）
# LLM_API_KEY=XXX

# # API 基础地址（通用字段，优先级高于下方旧字段）
# LLM_BASE_URL=https://api.openai.com/v1

# # 温度参数（默认 0.0）
# LLM_TEMPERATURE=0.0





# ====================嵌入模型=============================
MBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=d:/work/text2sql2/models/bge-m3

# ==================== ETL 配置 ====================
ETL_BATCH_SIZE=512           # ETL 批处理大小


# ==================== HuggingFace 镜像 ====================
HF_ENDPOINT=https://hf-mirror.com
